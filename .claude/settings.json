{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo run:*)",
      "Bash(cargo tree:*)",
      "Bash(rust-analyzer:*)",
      "Bash(pwsh -File scripts/verify.ps1:*)",
      "Bash(pwsh -File scripts/mutate.ps1:*)",
      "Bash(pwsh -File scripts/brief.ps1:*)",
      "Bash(pwsh -File scripts/check_briefs.ps1:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git cat-file:*)",
      "Bash(git rev-parse:*)",
      "Bash(sqlite3:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/subagent-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/rustfmt-on-edit.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
